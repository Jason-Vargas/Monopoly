<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Monopoly.App</RootNamespace>
    <Product>Monopoly Distribuido</Product>
    <!-- Solo recursos en español: reduce el tamaño del .exe publicado. -->
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Publicación en un único .exe autocontenido (ver publicar.ps1). Windows Forms no admite recorte (trimming). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- Fuentes de licencia libre (SIL OFL 1.1) incrustadas y cargadas con PrivateFontCollection (ver Estilo/Fuentes.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="Estilo\Fuentes\*.ttf" LogicalName="Monopoly.App.Fuentes.%(Filename)%(Extension)" />
    <None Include="Estilo\Fuentes\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="Licencias\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monopoly.Core\Monopoly.Core.csproj" />
  </ItemGroup>

</Project>

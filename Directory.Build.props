<Project>
  <!-- Configuración común a todos los proyectos de la solución. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- Deshabilitado: los usings implícitos incluyen System.Linq y System.Collections.Generic, prohibidos en este proyecto. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Jason Vargas, Adal Mejias, Moises Barboza</Authors>
    <Product>Monopoly Distribuido</Product>
  </PropertyGroup>
</Project>
